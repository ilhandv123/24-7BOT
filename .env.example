#!/usr/bin/env node

const mineflayer = require('mineflayer');
const dotenv = require('dotenv');
const fs = require('fs');
const path = require('path');

dotenv.config();

const config = {
  host: process.env.MC_HOST || 'play.example.com',
  port: Number(process.env.MC_PORT || 25565),
  username: process.env.MC_USERNAME || 'ILHANBOT',
  version: process.env.MC_VERSION || '1.21.11',
  reconnectDelayMs: Number(process.env.RECONNECT_DELAY_MS || 20000),
  chatIntervalMs: Number(process.env.CHAT_INTERVAL_MS || 300000),
  jumpIntervalMs: Number(process.env.JUMP_INTERVAL_MS || 180000),
  moveIntervalMs: Number(process.env.MOVE_INTERVAL_MS || 240000),
  restartDelayMs: Number(process.env.RESTART_DELAY_MS || 3600000),
  usernamePrefix: process.env.USERNAME_PREFIX || 'ILHANBOT',
};

function randomName(prefix = config.usernamePrefix) {
  const chars = 'abcdefghijklmnopqrstuvwxyz';
  let suffix = '';

  for (let i = 0; i < 5; i += 1) {
    suffix += chars[Math.floor(Math.random() * chars.length)];
  }

  return `${prefix}_${suffix}`;
}

function createBot() {
  const bot = mineflayer.createBot({
    host: config.host,
    port: config.port,
    username: config.username,
    version: config.version,
    auth: 'offline',
  });

  let reconnectTimer = null;
  let actionTimers = [];
  let lastChatAt = 0;
  let wasKicked = false;
  let isRestarting = false;

  function clearActionTimers() {
    actionTimers.forEach((timer) => clearInterval(timer));
    actionTimers = [];
  }

  function scheduleReconnect() {
    if (reconnectTimer) {
      clearTimeout(reconnectTimer);
    }

    reconnectTimer = setTimeout(() => {
      if (isRestarting) {
        return;
      }

      if (wasKicked) {
        config.username = randomName();
        console.log(`[bot] Kick detected. Reconnecting with new username: ${config.username}`);
      } else {
        console.log(`[bot] Reconnecting with username: ${config.username}`);
      }

      wasKicked = false;
      isRestarting = false;
      createBot();
    }, config.reconnectDelayMs);
  }

  function setLoop(callback, delay) {
    const timer = setInterval(callback, delay);
    actionTimers.push(timer);
    return timer;
  }

  function startAfkBehavior() {
    const messages = ['hello', 'hi', 'anyone here?', 'lets play', 'ok', 'hey'];

    setLoop(() => {
      const now = Date.now();
      if (now - lastChatAt >= config.chatIntervalMs || lastChatAt === 0) {
        const message = messages[Math.floor(Math.random() * messages.length)];
        try {
          bot.chat(message);
          console.log(`[bot] Chat: ${message}`);
          lastChatAt = now;
        } catch (error) {
          console.log(`[bot] Chat error: ${error.message}`);
        }
      }
    }, config.chatIntervalMs);

    setLoop(() => {
      try {
        bot.setControlState('jump', true);
        setTimeout(() => bot.setControlState('jump', false), 600);
        console.log('[bot] Jump action');
      } catch (error) {
        console.log(`[bot] Jump error: ${error.message}`);
      }
    }, config.jumpIntervalMs);

    setLoop(() => {
      try {
        const entity = bot.entity;
        if (!entity) {
          return;
        }

        const yaw = entity.yaw || 0;
        const pitch = entity.pitch || 0;
        const nextYaw = yaw + (Math.PI * 2) / 10;

        bot.look(nextYaw, pitch, true);
        bot.setControlState('forward', true);
        setTimeout(() => bot.setControlState('forward', false), 2500);
        console.log('[bot] Movement action');
      } catch (error) {
        console.log(`[bot] Movement error: ${error.message}`);
      }
    }, config.moveIntervalMs);

    if (config.restartDelayMs > 0) {
      setTimeout(() => {
        console.log('[bot] Restart timer reached');
        isRestarting = true;
        bot.quit();
      }, config.restartDelayMs);
    }
  }

  bot.on('spawn', () => {
    console.log(`[bot] Connected as ${config.username} on ${config.host}:${config.port}`);
    startAfkBehavior();
  });

  bot.on('kicked', (reason) => {
    wasKicked = true;
    console.log(`[bot] Kicked: ${reason || 'unknown reason'}`);
  });

  bot.on('error', (error) => {
    if (error && error.message) {
      console.log(`[bot] Error: ${error.message}`);
    }
  });

  bot.on('end', () => {
    clearActionTimers();
    console.log(`[bot] Connection closed. Reconnecting in ${Math.round(config.reconnectDelayMs / 1000)}s...`);
    scheduleReconnect();
  });

  return bot;
}

function ensureEnvExample() {
  const envPath = path.join(process.cwd(), '.env');
  const examplePath = path.join(process.cwd(), '.env.example');

  if (!fs.existsSync(envPath) && !fs.existsSync(examplePath)) {
    const exampleContent = `MC_HOST=play.example.com
MC_PORT=25565
MC_USERNAME=ILHANBOT
MC_VERSION=1.21.11
RECONNECT_DELAY_MS=20000
CHAT_INTERVAL_MS=300000
JUMP_INTERVAL_MS=180000
MOVE_INTERVAL_MS=240000
RESTART_DELAY_MS=3600000
USERNAME_PREFIX=ILHANBOT
`;

    fs.writeFileSync(examplePath, exampleContent, 'utf8');
    console.log('[setup] Created .env.example');
  }
}

function initialize() {
  ensureEnvExample();
  console.log('Minecraft AFK bot');
  console.log('------------------');
  console.log(`[bot] Using version: ${config.version}`);
  console.log(`[bot] Connecting to ${config.host}:${config.port} as ${config.username}`);
  createBot();
}

initialize();

process.on('uncaughtException', (error) => {
  console.error('[fatal] Uncaught exception:', error.message);
  process.exit(1);
});

process.on('unhandledRejection', (reason) => {
  console.error('[fatal] Unhandled rejection:', reason);
  process.exit(1);
});

